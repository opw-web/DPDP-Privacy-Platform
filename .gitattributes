# Line-ending policy.
#
# This repo is developed on Linux and also runs on Windows under Git Bash.
# Without this file, a Windows clone with core.autocrlf=true rewrites every
# shell script to CRLF, and bash then fails with "bad interpreter" on the
# shebang. Shell scripts and Python hooks must stay LF on every platform;
# only the Windows .cmd launchers want CRLF.

* text=auto

# Must be LF everywhere -- executed by bash / python, never by cmd.exe.
*.sh   text eol=lf
*.py   text eol=lf
*.bash text eol=lf

# Must be CRLF -- cmd.exe mis-parses LF-only batch files.
*.cmd text eol=crlf
*.bat text eol=crlf

# Linux desktop entries are read by the XDG launcher; keep them LF.
*.desktop text eol=lf

# Read by Prisma and psql, and compared byte-for-byte by a schema test.
*.sql text eol=lf

# Never touch these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.zip    binary
*.sqlite binary
*.ico    binary
*.woff   binary
*.woff2  binary
