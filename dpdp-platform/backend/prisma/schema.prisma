generator client {
  provider      = "prisma-client-js"
  // Task 7 Docker fix: node:20-alpine ships OpenSSL 3.x (libssl.so.3),
  // not the 1.1.x Prisma's engine auto-detection guesses at generate
  // time when it cannot probe the target system's actual libssl
  // (cross-container generate). Without an explicit binaryTarget here,
  // `prisma generate` silently produces a `linux-musl` (openssl-1.1.x)
  // engine that fails to load in the runtime image with "Error loading
  // shared library libssl.so.1.1: No such file or directory" -- caught
  // by `PrismaService.onModuleInit`'s startup guard (so the process
  // does not crash), but the Prisma client can never actually connect,
  // which is exactly the "uninitialized Prisma client" failure mode
  // this round's container-build verification exists to catch.
  // "native" keeps local dev (glibc host) working unchanged.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

